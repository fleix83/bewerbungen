# Kirby .htaccess - Minimal version

<IfModule mod_rewrite.c>

RewriteEngine on

# No RewriteBase — Apache auto-detects from .htaccess location
# Works as /bewerbungen/ locally and / on staging

# Terminmanager: exclude from Kirby
RewriteRule ^terminmanager/ - [L]

# Buchen routes -> Terminmanager SPA
RewriteRule ^buchen$ terminmanager/frontend/dist/index.html [L]
RewriteRule ^buchen/(.*)$ terminmanager/frontend/dist/index.html [L]

# block dot files
RewriteRule (^|/)\.(?!well-known\/) index.php [L]

# block content/site/kirby folders
RewriteRule ^content/(.*) index.php [L]
RewriteRule ^site/(.*) index.php [L]
RewriteRule ^kirby/(.*) index.php [L]

# serve static assets directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule .* - [L]

# route everything else to Kirby
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*) index.php [L]

</IfModule>
